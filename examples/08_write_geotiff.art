;===========================================================
; 08_write_geotiff.art
;
; Create a GeoTIFF from scratch: georeference it, write a
; synthetic gradient band, close, then read it back and render
; it as ASCII.
;
; Run from the repository root:
;   arturo examples/08_write_geotiff.art
;===========================================================

import "gdal"

do [
    path: "/tmp/gdal_art_demo.tif"
    w: 60
    h: 40

    ds: createDataset "GTiff" path w h 1 GDT_Float32
    if null? ds [ panic "could not create " ++ path ]

    ; a gradient: value grows left -> right and top -> bottom
    ; map builds the block in one pass; repeated block concatenation here is
    ; quadratic and makes this small example need tens of seconds.
    pixels: map 0..((w * h) - 1) 'i [
        x: i % w
        y: (i - x) / w
        100.0 + x + (y * 2)
    ]

    negSmall: 0.0 - 0.01
    rc1: setGeotransform ds @[77.0 0.01 0.0 31.0 0.0 negSmall]
    wkt: {GEOGCS["WGS 84",DATUM["WGS_1984",SPHEROID["WGS 84",6378137,298.257223563]],PRIMEM["Greenwich",0],UNIT["degree",0.0174532925199433]]}
    rc2: setProjection ds wkt
    rc3: writeBand ds 1 pixels
    print ["geotransform:" rc1 "projection:" rc2 "write:" rc3]
    closeDataset ds
    print ["wrote" path "(" w "x" h ")"]

    ; read it back with the normal read path
    ds2: gdalOpen path
    px: readBand ds2 1
    first: px\0
    lastIdx: (size px) - 1
    lastVal: px\[lastIdx]
    print ["read back" (size px) "pixels; first:" first "last:" lastVal]

    lo: px\0
    hi: px\0
    loop px 'v [
        if v < lo [ lo: v ]
        if v > hi [ hi: v ]
    ]
    chars: " .:-=+*#%@"
    print ""
    yy: 0
    while [yy < h] [
        rowChars: map 0..(w - 1) 'xx [
            v: px\[(yy * w) + xx]
            tt: (v - lo) / ((hi - lo) + 0.0001)
            idx: to :integer (tt * 9.0)
            if idx > 9 [ idx: 9 ]
            chars\[idx]
        ]
        print (join rowChars)
        yy: yy + 1
    ]
    print ""

    closeDataset ds2
]
