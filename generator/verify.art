;===========================================================
; gdal.art generator - verify
;
; Symbol verification (SPEC 29): every BOUND function's symbol is
; looked up in the shared library. A tiny C probe (SPEC 28) checks
; that the emitted constants agree with the compiled headers.
;===========================================================

; run `nm -gU` over the library and collect exported symbols
gsNmSymbols: function [gnsLib] [
    gnsOut: #[]
    gnsR: execute.code ("nm -gU \"" ++ gnsLib ++ "\"")
    if (gnsR\code) = 0 [
        loop (split.lines (gnsR\output)) 'gnsLine [
            gnsParts: split.by: " " (strip gnsLine)
            gnsLast: last gnsParts
            if not? (empty? gnsLast) [
                gnsSym: to :string gnsLast
                ; strip a leading underscore (Mach-O)
                if (size gnsSym) > 0 [
                    if (to :string (gnsSym\0)) = "_" [ gnsSym: slice gnsSym 1 (size gnsSym) - 1 ]
                ]
                set gnsOut gnsSym true
            ]
        ]
    ]
    return gnsOut
]

; missing symbols among BOUND functions
gsVerifySymbols: function [gvsFns] [
    gvsSyms: gsNmSymbols gsLibTarget
    gvsMissing: []
    loop gvsFns 'gvsFn [
        if (gvsFn\disposition) = "BOUND" [
            if not? (contains? (keys gvsSyms) (gvsFn\name)) [
                gvsMissing: gvsMissing ++ @[(gvsFn\name)]
            ]
        ]
    ]
    return gvsMissing
]

; emit a C probe that prints every constant we generate, for ABI checking
gsAbiProbeSource: function [] [
    gapS: ""
    gapS: gapS ++ "#include <stdio.h>\n"
    loop gsHeaders 'gapH [ gapS: gapS ++ "#include \"" ++ (to :string gapH) ++ "\"\n" ]
    gapS: gapS ++ "int main(void) {\n"
    gapNames: sort (keys gsConstants)
    loop gapNames 'gapN [
        gapS: gapS ++ "    printf(\"" ++ (to :string gapN) ++ " %ld\\n\", (long)(" ++ (to :string gapN) ++ "));\n"
    ]
    gapS: gapS ++ "    return 0;\n"
    gapS: gapS ++ "}\n"
    return gapS
]

; compile and run the constant probe; compare every value against
; gsConstants (SPEC 28). Returns #[ok: reason:]
gsVerifyAbi: function [] [
    gvaSrc: gsAbiProbeSource
    write gvaSrc ".gen_tmp_abi.c"
    gvaC: gsExecCode ("cc -I" ++ gsIncludeDir ++ " .gen_tmp_abi.c -o .gen_tmp_abi 2>&1")
    if not? ((gvaC\code) = 0) [
        print ["abi probe compile failed:" gvaC\output]
        gvaQ: gsExecCode "rm -f .gen_tmp_abi.c .gen_tmp_abi"
        return #[ok: false reason: "compile"]
    ]
    gvaR: gsExecCode "./.gen_tmp_abi 2>&1"
    gvaQ: gsExecCode "rm -f .gen_tmp_abi.c .gen_tmp_abi"
    if not? ((gvaR\code) = 0) [
        print ["abi probe run failed:" gvaR\output]
        return #[ok: false reason: "run"]
    ]
    gvaBad: []
    loop (split.lines (gvaR\output)) 'gvaLine [
        gvaL: strip gvaLine
        if not? (empty? gvaL) [
            gvaParts: split.by: " " gvaL
            if (size gvaParts) >= 2 [
                gvaName: to :string (gvaParts\0)
                gvaVal: gsParseInt (to :string (gvaParts\1))
                if contains? (keys gsConstants) gvaName [
                    if not? ((get gsConstants gvaName) = gvaVal) [
                        gvaBad: gvaBad ++ @[(gvaName ++ " expected " ++ (to :string (get gsConstants gvaName)) ++ " got " ++ (to :string gvaVal))]
                    ]
                ]
            ]
        ]
    ]
    return #[ok: (empty? gvaBad) reason: gvaBad]
]
