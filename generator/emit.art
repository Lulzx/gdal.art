;===========================================================
; gdal.art generator - emit
;
; Builds the generated Arturo sources and the manifest as text.
; The raw layer is a 1:1 mapping of the C API (SPEC 16):
;   GDALOpenEx            -> gdalOpenEx
;   GDALGetRasterXSize    -> gdalGetRasterXSize
;   OGR_G_ExportToWkt     -> ogr_G_ExportToWkt
;
; C NULL pointers become Arturo null (gdalNullIf), never integer 0.
;===========================================================

; GDALOpenEx -> gdalOpenEx (lowercase the leading acronym prefix,
; not just the first character: GDALGetRasterXSize -> gdalGetRasterXSize)
gsEmitPrefixes: ["GDAL" "OGR" "OSR" "CPL" "CSL" "VSIF" "GNM" "OCT" "CXT"]

gsEmitName: function [genCName] [
    genPref: ""
    genRest: genCName
    loop gsEmitPrefixes 'genP [
        genPs: to :string genP
        if (size genCName) >= (size genPs) [
            if (slice genCName 0 (size genPs) - 1) = genPs [
                genPref: lower genPs
                genRest: slice genCName (size genPs) (size genCName) - 1
            ]
        ]
    ]
    if empty? genPref [
        genFirst: lower (to :string (genCName\0))
        return genFirst ++ (slice genCName 1 (size genCName) - 1)
    ]
    return genPref ++ genRest
]

; which functions to emit as raw bindings
gsBoundFunctions: function [gbfFns] [
    gbfOut: []
    loop gbfFns 'gbfFn [
        if (gbfFn\disposition) = "BOUND" [ gbfOut: gbfOut ++ @[gbfFn] ]
    ]
    return gbfOut
]

; the call-target string "Lib::Symbol|retAbi|argAbi,..."
gsTarget: function [gtsFn] [
    gtsArgAbis: map (gtsFn\args) 'gtsA [ gtsA\desc\abi ]
    gtsRetAbi: gtsFn\return\abi
    if null = gtsRetAbi [ gtsRetAbi: "void" ]
    return gsLibTarget ++ "::" ++ (gtsFn\name) ++ "|" ++ gtsRetAbi ++ "|" ++ (join.with: "," gtsArgAbis)
]

; encode-spec list text: ["str" "u32" "ptr" ...]
gsEncodeSpecsText: function [gestFn] [
    gestParts: map (gestFn\args) 'gestA [ "\"" ++ gestA\desc\abi ++ "\"" ]
    return join.with: " " gestParts
]

; argument name list text: "a0 a1 a2"
gsArgNamesText: function [gantFn] [
    gantI: 0
    gantParts: []
    loop (gantFn\args) 'gantA [
        gantParts: gantParts ++ @["a" ++ (to :string gantI)]
        gantI: gantI + 1
    ]
    return join.with: " " gantParts
]

; the return-handling body of a raw wrapper
gsReturnBody: function [grbFn grbTarget grbSpecs grbArgs] [
    grbKind: grbFn\return\kind
    grbAbi: grbFn\return\abi
    if grbKind = "void" [
        return "return (ffiDoVoid \"" ++ grbTarget ++ "\" (ffiEncodeArgs [" ++ grbSpecs ++ "] @[" ++ grbArgs ++ "]))"
    ]
    if grbAbi = "bool" [
        return "return (ffiAsBool (ffiRawCall \"" ++ grbTarget ++ "\" (ffiEncodeArgs [" ++ grbSpecs ++ "] @[" ++ grbArgs ++ "])))"
    ]
    if or? (grbAbi = "f32") (grbAbi = "f64") [
        return "return (to :floating (ffiRawCallS \"" ++ grbTarget ++ "\" (ffiEncodeArgs [" ++ grbSpecs ++ "] @[" ++ grbArgs ++ "])))"
    ]
    if grbAbi = "str" [
        return "return (gdalNullStr (ffiRawCallS \"" ++ grbTarget ++ "\" (ffiEncodeArgs [" ++ grbSpecs ++ "] @[" ++ grbArgs ++ "])))"
    ]
    if grbAbi = "ptr" [
        return "return (gdalNullIf (ffiRawCall \"" ++ grbTarget ++ "\" (ffiEncodeArgs [" ++ grbSpecs ++ "] @[" ++ grbArgs ++ "])))"
    ]
    ; integer scalars
    return "return (ffiRawCall \"" ++ grbTarget ++ "\" (ffiEncodeArgs [" ++ grbSpecs ++ "] @[" ++ grbArgs ++ "]))"
]

; generate the raw bindings source
gsGenBindings: function [ggbFns] [
    ggbS: ""
    ggbS: ggbS ++ "; DO NOT EDIT\n"
    ggbS: ggbS ++ "; Generated by generator/main.art from the installed GDAL C headers.\n"
    ggbS: ggbS ++ "; GDAL version: " ++ gsVersion ++ "\n\n"
    ggbS: ggbS ++ "; map a C NULL pointer (integer 0) to Arturo null (SPEC 16)\n"
    ggbS: ggbS ++ "gdalNullIf: function [gdnP][ if gdnP = 0 [ return null ] return gdnP ]\n"
    ggbS: ggbS ++ "; map a C NULL const char* (adapter sentinel SOH) to Arturo null\n"
    ggbS: ggbS ++ "gdalNullStr: function [gdnS][ if gdnS = (to :string (to :char 1)) [ return null ] return gdnS ]\n\n"
    ggbS: ggbS ++ "; raw bindings (1:1 with the C API)\n"
    loop (gsBoundFunctions ggbFns) 'ggbFn [
        ggbTarget: gsTarget ggbFn
        ggbSpecs: gsEncodeSpecsText ggbFn
        ggbArgs: gsArgNamesText ggbFn
        ggbName: gsEmitName (ggbFn\name)
        ggbS: ggbS ++ "\n" ++ ggbName ++ ": function [" ++ ggbArgs ++ "][\n"
        ggbS: ggbS ++ "    " ++ (gsReturnBody ggbFn ggbTarget ggbSpecs ggbArgs) ++ "\n"
        ggbS: ggbS ++ "]\n"
    ]
    ggbS: ggbS ++ "\n"
    return ggbS
]

; generate the constants source
gsGenConstants: function [] [
    ggcS: ""
    ggcS: ggcS ++ "; DO NOT EDIT\n"
    ggcS: ggcS ++ "; Generated constants (enums + #define) from the installed GDAL headers.\n\n"
    ggcNames: sort (keys gsConstants)
    loop ggcNames 'ggcN [
        ggcV: get gsConstants ggcN
        ggcVs: to :string ggcV
        ; a negative literal would poison this Arturo build's exit code,
        ; so emit `0 - N` instead of `-N`
        if (to :string (ggcVs\0)) = "-" [
            ggcVs: "0-" ++ (slice ggcVs 1 (size ggcVs) - 1)
        ]
        ggcS: ggcS ++ (to :string ggcN) ++ ": " ++ ggcVs ++ "\n"
    ]
    ggcS: ggcS ++ "\n"
    return ggcS
]

; generate handle/type metadata
gsGenTypes: function [ggtFns ggtMissing] [
    ggtS: ""
    ggtS: ggtS ++ "; DO NOT EDIT\n"
    ggtS: ggtS ++ "; Generated handle/type metadata. Handles are Arturo-level\n"
    ggtS: ggtS ++ "; distinctions; at the FFI boundary they are all `ptr` (SPEC 9).\n\n"
    ggtS: ggtS ++ "gdalHandles: #[\n"
    ggtNames: sort (keys gsTypedefs)
    loop ggtNames 'ggtN [
        ggtD: get gsTypedefs ggtN
        if (ggtD\kind) = "handle" [
            ggtS: ggtS ++ "    \"" ++ (to :string ggtN) ++ "\": \"" ++ (ggtD\handle) ++ "\"\n"
        ]
    ]
    ggtS: ggtS ++ "]\n\n"
    ggtS: ggtS ++ "gdalDeferred: #[\n"
    loop ggtFns 'ggtFn [
        if (ggtFn\disposition) = "DEFERRED" [
            ggtS: ggtS ++ "    \"" ++ (ggtFn\name) ++ "\": \"" ++ (ggtFn\reason) ++ "\"\n"
        ]
    ]
    ggtS: ggtS ++ "]\n\n"
    ggtS: ggtS ++ "; functions declared in the headers but not exported by the\n"
    ggtS: ggtS ++ "; installed library (SPEC 29) - guard calls with gdalHasSymbol\n"
    ggtS: ggtS ++ "gdalMissingSymbols: [\n"
    loop ggtMissing 'ggtM [ ggtS: ggtS ++ "    \"" ++ (to :string ggtM) ++ "\"\n" ]
    ggtS: ggtS ++ "]\n\n"
    ggtS: ggtS ++ "; C names of generated BOUND wrappers (SPEC 29)\n"
    ggtS: ggtS ++ "gdalBoundSymbols: [\n"
    loop (gsBoundFunctions ggtFns) 'ggtB [
        ggtS: ggtS ++ "    \"" ++ (ggtB\name) ++ "\"\n"
    ]
    ggtS: ggtS ++ "]\n\n"
    return ggtS
]

; generate the ownership source
gsGenOwnership: function [ggoFns] [    ggoS: ""
    ggoS: ggoS ++ "; DO NOT EDIT\n"
    ggoS: ggoS ++ "; Ownership of pointer-returning functions (SPEC 11).\n"
    ggoS: ggoS ++ "; `unknown` is emitted deliberately when unverified.\n\n"
    ggoS: ggoS ++ "gdalOwnership: #[\n"
    loop ggoFns 'ggoFn [
        if (ggoFn\disposition) = "BOUND" [
            if ggoFn\return\kind = "handle" [
                ggoOwn: gsOwnershipFor (ggoFn\name)
                ggoS: ggoS ++ "    \"" ++ (ggoFn\name) ++ "\": #[\n"
                ggoS: ggoS ++ "        ownership: \"" ++ (ggoOwn\ownership) ++ "\"\n"
                if null = (ggoOwn\release) [
                    ggoS: ggoS ++ "        release: null\n"
                ]
                if not? (null = (ggoOwn\release)) [
                    ggoS: ggoS ++ "        release: \"" ++ (ggoOwn\release) ++ "\"\n"
                ]
                ggoS: ggoS ++ "    ]\n"
            ]
        ]
    ]
    ggoS: ggoS ++ "]\n\n"
    return ggoS
]

; build the generation manifest JSON (no timestamp; deterministic)
gsGenManifest: function [ggmCounts] [
    ggmS: ""
    ggmS: ggmS ++ "{\n"
    ggmS: ggmS ++ "  \"gdal_version\": \"" ++ gsVersion ++ "\",\n"
    ggmS: ggmS ++ "  \"include_path\": \"" ++ gsIncludeDir ++ "\",\n"
    ggmS: ggmS ++ "  \"library_path\": \"" ++ gsLibDir ++ "\",\n"
    ggmS: ggmS ++ "  \"library_name\": \"" ++ gsLibName ++ "\",\n"
    ggmS: ggmS ++ "  \"generator_version\": \"" ++ gsGenVersion ++ "\",\n"
    ggmS: ggmS ++ "  \"arturo_ffi_version\": \"" ++ gsFfiVersion ++ "\",\n"
    ggmS: ggmS ++ "  \"adapter_version\": " ++ (to :string gsAdapterVersion) ++ ",\n"
    ggmS: ggmS ++ "  \"platform\": \"" ++ gsPlatform ++ "\",\n"
    ggmS: ggmS ++ "  \"architecture\": \"" ++ gsArch ++ "\",\n"
    ggmS: ggmS ++ "  \"preprocess_command\": \"" ++ gsPreprocessCmd ++ "\",\n"
    ggmS: ggmS ++ "  \"functions_seen\": " ++ (to :string (ggmCounts\total)) ++ ",\n"
    ggmS: ggmS ++ "  \"functions_bound\": " ++ (to :string (ggmCounts\bound)) ++ ",\n"
    ggmS: ggmS ++ "  \"functions_deferred\": " ++ (to :string (ggmCounts\deferred)) ++ ",\n"
    ggmS: ggmS ++ "  \"functions_ignored\": " ++ (to :string (ggmCounts\ignored)) ++ "\n"
    ggmS: ggmS ++ "}\n"
    return ggmS
]
