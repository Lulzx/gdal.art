;===========================================================
; gdal.art - idiomatic sugar
;
; A small layer over the generated 1:1 bindings. The raw layer
; stays recognizable (gdalOpenEx, ogr_G_ExportToWkt, ...); these
; helpers are convenience only and never replace it.
;===========================================================

;------------------------------------------------------------------
; dataset open/close
;------------------------------------------------------------------

; open a dataset, read-only, any driver (raster or vector). This is the
; main entry point: gdalOpen "map.tif" or gdalOpen "points.geojson".
gdalOpen: function [goPath] [
    goR: gdalAllRegister
    return (gdalOpenEx goPath GDAL_OF_ALL null null null)
]

; open with a driver kind / access mode; mode is required:
;   'raster / 'vector   restrict the driver kind, read-only
;   'update             any driver, read-write
gdalOpenMode: function [gomPath gomMode] [
    goR: gdalAllRegister
    goFlags: GDAL_OF_ALL
    if gomMode = 'raster [ goFlags: GDAL_OF_RASTER ]
    if gomMode = 'vector [ goFlags: GDAL_OF_VECTOR ]
    if gomMode = 'update [ goFlags: GDAL_OF_UPDATE ]
    return (gdalOpenEx gomPath goFlags null null null)
]

openDataset: function [odPath][ return (gdalOpenMode odPath 'raster) ]
openVector: function [ovPath][ return (gdalOpenMode ovPath 'vector) ]

closeDataset: function [cdDs][ return (gdalClose cdDs) ]

; the GDAL release, e.g. "3.13.2"
gdalVersion: function [] [ return (gdalVersionInfo "RELEASE_NAME") ]

;------------------------------------------------------------------
; raster creation / writing
;------------------------------------------------------------------

; create a new raster dataset via a driver short name ("GTiff", "PNG", ...)
createDataset: function [cdDriver cdPath cdW cdH cdBands cdType] [
    cdR: gdalAllRegister
    cdD: gdalGetDriverByName cdDriver
    if null? cdD [ return null ]
    return (gdalCreate cdD cdPath cdW cdH cdBands cdType null)
]

setProjection: function [spDs spWkt][ return (gdalSetProjection spDs spWkt) ]

; set the affine geotransform from a [gt0..gt5] block
setGeotransform: function [sgtDs sgtGT] [
    sgtBuf: ffiAlloc 48
    sgtS1: ffiStoreF64 sgtBuf 0 (sgtGT\0)
    sgtS2: ffiStoreF64 sgtBuf 8 (sgtGT\1)
    sgtS3: ffiStoreF64 sgtBuf 16 (sgtGT\2)
    sgtS4: ffiStoreF64 sgtBuf 24 (sgtGT\3)
    sgtS5: ffiStoreF64 sgtBuf 32 (sgtGT\4)
    sgtS6: ffiStoreF64 sgtBuf 40 (sgtGT\5)
    sgtRc: gdalSetGeoTransform sgtDs sgtBuf
    sgtF: ffiFree sgtBuf
    return sgtRc
]

; write one band from a flat row-major block of Arturo numbers
writeBand: function [wbDs wbIndex wbPixels] [
    wbB: gdalGetRasterBand wbDs wbIndex
    if null? wbB [ return null ]
    wbW: gdalGetRasterBandXSize wbB
    wbH: gdalGetRasterBandYSize wbB
    wbT: gdalGetRasterDataType wbB
    wbBps: bandBytes wbT
    if wbBps = 0 [ return null ]
    wbN: wbW * wbH
    wbBuf: ffiAlloc (wbN * wbBps)
    wbI: 0
    while [wbI < wbN] [
        wbV: wbPixels\[wbI]
        if wbT = GDT_Byte [ wbS1: ffiStoreU8 wbBuf wbI wbV ]
        if wbT = GDT_UInt16 [ wbS2: ffiStoreU16 wbBuf (wbI * 2) wbV ]
        if wbT = GDT_Int16 [ wbS3: ffiStoreI16 wbBuf (wbI * 2) wbV ]
        if wbT = GDT_UInt32 [ wbS4: ffiStoreU32 wbBuf (wbI * 4) wbV ]
        if wbT = GDT_Int32 [ wbS5: ffiStoreI32 wbBuf (wbI * 4) wbV ]
        if wbT = GDT_Float32 [ wbS6: ffiStoreF32 wbBuf (wbI * 4) wbV ]
        if wbT = GDT_Float64 [ wbS7: ffiStoreF64 wbBuf (wbI * 8) wbV ]
        wbI: wbI + 1
    ]
    wbRc: gdalRasterIO wbB GF_Write 0 0 wbW wbH wbBuf wbW wbH wbT 0 0
    wbF: ffiFree wbBuf
    return wbRc
]

;------------------------------------------------------------------
; dataset facts
;------------------------------------------------------------------

rasterWidth: function [rwDs][ return (gdalGetRasterXSize rwDs) ]
rasterHeight: function [rhDs][ return (gdalGetRasterYSize rhDs) ]
rasterCount: function [rcDs][ return (gdalGetRasterCount rcDs) ]

rasterSize: function [rsDs] [
    rsW: gdalGetRasterXSize rsDs
    rsH: gdalGetRasterYSize rsDs
    rsB: gdalGetRasterCount rsDs
    return #[width: rsW height: rsH bands: rsB]
]

driverName: function [dnDs] [
    dnDrv: gdalGetDatasetDriver dnDs
    if null? dnDrv [ return null ]
    return (gdalGetDriverShortName dnDrv)
]

driverLongName: function [dlnDs] [
    dlnDrv: gdalGetDatasetDriver dlnDs
    if null? dlnDrv [ return null ]
    return (gdalGetDriverLongName dlnDrv)
]

description: function [deDs][ return (gdalGetDescription deDs) ]

; a single metadata item from the default domain (or "" if absent)
metadataItem: function [miDs miKey][ return (gdalGetMetadataItem miDs miKey "") ]

; bytes per pixel for a GDALDataType
bandBytes: function [bbT] [
    if bbT = GDT_Byte [ return 1 ]
    if bbT = GDT_UInt16 [ return 2 ]
    if bbT = GDT_Int16 [ return 2 ]
    if bbT = GDT_UInt32 [ return 4 ]
    if bbT = GDT_Int32 [ return 4 ]
    if bbT = GDT_Float32 [ return 4 ]
    if bbT = GDT_Float64 [ return 8 ]
    return 0
]

; data type code of a band (GDT_*)
bandDataType: function [bdBand][ return (gdalGetRasterDataType bdBand) ]

; facts about one band as a dict
bandInfo: function [biDs biIndex] [
    biB: gdalGetRasterBand biDs biIndex
    if null? biB [ return null ]
    biT: gdalGetRasterDataType biB
    biW: gdalGetRasterBandXSize biB
    biH: gdalGetRasterBandYSize biB
    biBuf: ffiAlloc 4
    biN: gdalGetRasterNoDataValue biB biBuf
    biHas: ffiLoadI32 biBuf 0
    biF: ffiFree biBuf
    biNodata: null
    if not? (biHas = 0) [ biNodata: biN ]
    return #[type: biT width: biW height: biH nodata: biNodata]
]

; read one band into a flat block of Arturo numbers (row-major)
readBand: function [rbDs rbIndex] [
    rbB: gdalGetRasterBand rbDs rbIndex
    if null? rbB [ return null ]
    rbW: gdalGetRasterBandXSize rbB
    rbH: gdalGetRasterBandYSize rbB
    rbT: gdalGetRasterDataType rbB
    rbBps: bandBytes rbT
    if rbBps = 0 [ return null ]
    rbN: rbW * rbH
    rbBuf: ffiAlloc (rbN * rbBps)
    rbRc: gdalRasterIO rbB GF_Read 0 0 rbW rbH rbBuf rbW rbH rbT 0 0
    if not? (rbRc = 0) [
        rbF1: ffiFree rbBuf
        return null
    ]
    rbOut: []
    rbI: 0
    while [rbI < rbN] [
        rbV: 0
        if rbT = GDT_Byte [ rbV: ffiLoadU8 rbBuf rbI ]
        if rbT = GDT_UInt16 [ rbV: ffiLoadU16 rbBuf (rbI * 2) ]
        if rbT = GDT_Int16 [ rbV: ffiLoadI16 rbBuf (rbI * 2) ]
        if rbT = GDT_UInt32 [ rbV: ffiLoadU32 rbBuf (rbI * 4) ]
        if rbT = GDT_Int32 [ rbV: ffiLoadI32 rbBuf (rbI * 4) ]
        if rbT = GDT_Float32 [ rbV: ffiLoadF32 rbBuf (rbI * 4) ]
        if rbT = GDT_Float64 [ rbV: ffiLoadF64 rbBuf (rbI * 8) ]
        rbOut: rbOut ++ @[rbV]
        rbI: rbI + 1
    ]
    rbF2: ffiFree rbBuf
    return rbOut
]

; the affine geotransform as [gt0 gt1 gt2 gt3 gt4 gt5]
geotransform: function [gtDs] [
    gtBuf: ffiAlloc 48
    gtRc: gdalGetGeoTransform gtDs gtBuf
    if not? (gtRc = 0) [
        gtF1: ffiFree gtBuf
        return null
    ]
    gtOut: []
    gtI: 0
    while [gtI < 6] [
        gtOut: gtOut ++ @[(ffiLoadF64 gtBuf (gtI * 8))]
        gtI: gtI + 1
    ]
    gtF2: ffiFree gtBuf
    return gtOut
]

; the dataset's WKT projection (const char*, borrowed)
projection: function [prDs][ return (gdalGetProjectionRef prDs) ]

;-----------------------------------------------------------
; vector / OGR sugar
;-----------------------------------------------------------

layerCount: function [lcDs][ return (gdalDatasetGetLayerCount lcDs) ]
layerAt: function [laDs laI][ return (gdalDatasetGetLayer laDs laI) ]
layerNamed: function [lnDs lnName][ return (gdalDatasetGetLayerByName lnDs lnName) ]
layerName: function [lnL][ return (ogr_L_GetName lnL) ]
layerGeometryType: function [lgtL][ return (ogr_L_GetGeomType lgtL) ]

; iterate every layer of a dataset; each layer handle is bound to
; itemName (a literal) inside the body, e.g.
;   eachLayer ds 'layer [ print [layerName layer (layerGeometryType layer)] ]
eachLayer: function [elDs elItemName elBody] [
    elLayers: []
    elN: gdalDatasetGetLayerCount elDs
    elI: 0
    while [elI < elN] [
        elLayers: elLayers ++ @[(gdalDatasetGetLayer elDs elI)]
        elI: elI + 1
    ]
    loop elLayers elItemName [ do elBody ]
]

resetReading: function [rrLayer][ return (ogr_L_ResetReading rrLayer) ]
nextFeature: function [nfLayer][ return (ogr_L_GetNextFeature nfLayer) ]
featureCount: function [fcLayer][ return (ogr_L_GetFeatureCount fcLayer 0) ]
destroyFeature: function [dfF][ return (ogr_F_Destroy dfF) ]

; iterate a layer's features; each feature handle is bound to itemName
; (a literal) inside the body and destroyed automatically afterwards,
; e.g.
;   eachFeature layer 'f [
;       print [featureId f (featureWkt f)]
;   ]
eachFeature: function [efLayer efItemName efBody] [
    efR: ogr_L_ResetReading efLayer
    efFs: []
    efF: ogr_L_GetNextFeature efLayer
    while [not? null? efF] [
        efFs: efFs ++ @[efF]
        efF: ogr_L_GetNextFeature efLayer
    ]
    loop efFs efItemName [ do efBody ]
    loop efFs 'efKill [
        efK: ogr_F_Destroy efKill
    ]
]

featureId: function [fiF][ return (ogr_F_GetFID fiF) ]
fieldCount: function [fncF][ return (ogr_F_GetFieldCount fncF) ]
fieldAsString: function [fasF fasI][ return (ogr_F_GetFieldAsString fasF fasI) ]
featureGeometry: function [fgF][ return (ogr_F_GetGeometryRef fgF) ]

; the value of a named field, or null when the field does not exist
featureField: function [ffF ffName] [
    ffIdx: ogr_F_GetFieldIndex ffF ffName
    if ffIdx < 0 [ return null ]
    return (ogr_F_GetFieldAsString ffF ffIdx)
]

; every field as a list of #[name: .. value: ..] records
featureFields: function [ffsF] [
    ffsN: ogr_F_GetFieldCount ffsF
    ffsOut: []
    ffsI: 0
    while [ffsI < ffsN] [
        ffsD: ogr_F_GetFieldDefnRef ffsF ffsI
        ffsName: ogr_Fld_GetNameRef ffsD
        ffsVal: ogr_F_GetFieldAsString ffsF ffsI
        ffsOut: ffsOut ++ @[#[name: ffsName value: ffsVal]]
        ffsI: ffsI + 1
    ]
    return ffsOut
]

; export a geometry to WKT via the OGR_G_ExportToWkt char** out-slot
; (SPEC 13). The returned string is freed with GDAL's allocator (SPEC 12).
geometryWkt: function [gwGeom] [
    gwSlot: ffiAlloc 8
    gwS1: ffiStorePtr gwSlot 0 0
    gwRc: ogr_G_ExportToWkt gwGeom gwSlot
    if not? (gwRc = 0) [
        gwS2: ffiFree gwSlot
        return null
    ]
    gwPtr: ffiLoadPtr gwSlot 0
    gwOut: null
    if not? (gwPtr = 0) [ gwOut: ffiLoadCString gwPtr ]
    if not? (gwPtr = 0) [ gwS3: vsifree gwPtr ]
    gwS4: ffiFree gwSlot
    return gwOut
]

featureWkt: function [fwF][
    fwG: ogr_F_GetGeometryRef fwF
    if null? fwG [ return null ]
    return (geometryWkt fwG)
]

geometryName: function [gnG][ return (ogr_G_GetGeometryName gnG) ]
geometryType: function [gtG][ return (ogr_G_GetGeometryType gtG) ]

;-----------------------------------------------------------
; spatial reference / coordinate transformation sugar
;-----------------------------------------------------------

; build a spatial reference from "EPSG:4326" or a WKT string.
; Axis mapping is set to traditional GIS order (lon,lat) so callers
; can use longitude/latitude explicitly (SPEC 24).
spatialReference: function [srDef] [
    srS: osrNewSpatialReference ""
    if null? srS [ return null ]
    srRc: 1
    if (size srDef) > 5 [
        if (slice srDef 0 3) = "EPSG" [
            srCodeStr: slice srDef 5 (size srDef) - 1
            srRc: osrImportFromEPSG srS (to :integer srCodeStr)
        ]
    ]
    if not? (srRc = 0) [
        srRc: osrImportFromWkt srS srDef
    ]
    if not? (srRc = 0) [
        srD: osrDestroySpatialReference srS
        return null
    ]
    srA: osrSetAxisMappingStrategy srS OAMS_TRADITIONAL_GIS_ORDER
    return srS
]

destroySpatialReference: function [dsrS][ return (osrDestroySpatialReference dsrS) ]

; transform one [x y] point from src to dst CRS; returns [x y]
transformPoint: function [tpSrc tpDst tpXY] [
    tpCt: octNewCoordinateTransformation tpSrc tpDst
    if null? tpCt [ return null ]
    tpBuf: ffiAlloc 24
    tpS1: ffiStoreF64 tpBuf 0 (tpXY\0)
    tpS2: ffiStoreF64 tpBuf 8 (tpXY\1)
    tpS3: ffiStoreF64 tpBuf 16 0.0
    tpOk: octTransform tpCt 1 tpBuf (tpBuf + 8) (tpBuf + 16)
    tpX: ffiLoadF64 tpBuf 0
    tpY: ffiLoadF64 tpBuf 8
    tpD: octDestroyCoordinateTransformation tpCt
    tpF: ffiFree tpBuf
    if tpOk = 0 [ return null ]
    return @[tpX tpY]
]
